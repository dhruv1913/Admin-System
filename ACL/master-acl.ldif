dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword
  by self write
  by anonymous auth
  by dn.regex="^cn=admin,ou=[a-zA-Z0-9_-]+,dc=adminsystem,dc=com$" write
  by * none
olcAccess: {1}to attrs=businessCategory,departmentNumber,employeeType
  by dn.regex="^cn=admin,ou=[a-zA-Z0-9_-]+,dc=adminsystem,dc=com$" write
  by * read
olcAccess: {2}to dn.regex="^cn=(admin|manager),ou=([^,]+),dc=adminsystem,dc=com$"
  by dn.regex="^cn=admin,ou=$2,dc=adminsystem,dc=com$" write
  by * read
olcAccess: {3}to dn.regex="^uid=[^,]+,ou=([^,]+),dc=adminsystem,dc=com$"
  by dn.regex="^cn=admin,ou=$1,dc=adminsystem,dc=com$" write
  by dn.regex="^cn=manager,ou=$1,dc=adminsystem,dc=com$" write
  by self write
  by * read
olcAccess: {4}to *
  by * read